---
import type { Project } from '../types/project';

interface Props {
  project: Project;
  index?: number;
}

const { project, index = 0 } = Astro.props;

// Printing Press monochrome palette: paper/ink + crimson/pink/green accents
const typeColors: Record<string, { bg: string; text: string }> = {
  blog:      { bg: 'bg-success-100 dark:bg-success-700/40',  text: 'text-success-600 dark:text-success-400' },
  docs:      { bg: 'bg-primary-100 dark:bg-primary-800/40',  text: 'text-primary-700 dark:text-primary-300' },
  landing:   { bg: 'bg-accent/15 dark:bg-accent/25',          text: 'text-accent dark:text-accent' },
  app:       { bg: 'bg-paper-2 dark:bg-surface-800',          text: 'text-ink dark:text-paper' },
  game:      { bg: 'bg-primary-100 dark:bg-primary-800/40',  text: 'text-primary-700 dark:text-primary-300' },
  tutorial:  { bg: 'bg-success-100 dark:bg-success-700/40',  text: 'text-success-700 dark:text-success-400' },
  portfolio: { bg: 'bg-accent/15 dark:bg-accent/25',          text: 'text-accent dark:text-accent' },
};

const colors     = typeColors[project.type] || typeColors.app;
const isComingSoon = project.status === 'coming-soon';
const isArchived   = project.status === 'archived';

// Stagger: max 6 columns, cap at 5 per row so timing stays calm on dense grids
const staggerMs  = Math.min(index % 3, 2) * 80 + Math.floor(index / 3) * 60;
---

{isComingSoon ? (
  <!-- Coming-soon: no tilt, entrance only -->
  <div
    class:list={[
      'card-entrance motion-fade-up',
      'group block rounded-xs border border-paper-2 dark:border-surface-800 bg-paper dark:bg-surface-800 p-6 transition-all duration-200',
      'opacity-80 cursor-default',
      isArchived && 'opacity-60',
    ]}
    style={`--motion-delay: ${staggerMs}ms`}
  >
    <div class="flex items-start justify-between gap-3 mb-3">
      <span class:list={['inline-flex items-center rounded-none px-2.5 py-0.5 text-xs font-medium uppercase tracking-wider', colors.bg, colors.text]}>
        {project.type}
      </span>
      <span class="inline-flex items-center rounded-none bg-paper-2 dark:bg-surface-800 px-2.5 py-0.5 text-xs font-medium uppercase tracking-wider text-surface-600 dark:text-surface-400">
        Coming Soon
      </span>
    </div>

    <h3 class="font-serif text-lg font-semibold text-ink dark:text-paper mb-2 transition-colors">
      {project.name}
    </h3>

    <p class="text-sm text-surface-500 dark:text-surface-400 mb-4 line-clamp-3">
      {project.description}
    </p>

    <div class="flex flex-wrap gap-1.5">
      {project.techStack.map((tech) => (
        <span class="inline-flex items-center rounded-none bg-paper-2 dark:bg-surface-800 px-2 py-0.5 text-xs text-surface-600 dark:text-surface-400">
          {tech}
        </span>
      ))}
    </div>
  </div>
) : (
  <!-- Active card: 3D tilt wrapper + entrance -->
  <div
    class="card-entrance motion-fade-up card-tilt-wrapper"
    style={`--motion-delay: ${staggerMs}ms`}
  >
    <a
      href={project.url}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[
        'card-tilt-inner ink-press',
        'group block rounded-xs border border-paper-2 dark:border-surface-800 bg-paper dark:bg-surface-800 p-6',
        'hover:border-primary-500 dark:hover:border-primary-400 hover:-translate-y-0.5',
        'transition-colors duration-200',
        isArchived && 'opacity-60',
      ]}
    >
      <div class="flex items-start justify-between gap-3 mb-3">
        <span class:list={['inline-flex items-center rounded-none px-2.5 py-0.5 text-xs font-medium uppercase tracking-wider', colors.bg, colors.text]}>
          {project.type}
        </span>
      </div>

      <h3 class="font-serif text-lg font-semibold text-ink dark:text-paper mb-2 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
        {project.name}
      </h3>

      <p class="text-sm text-surface-500 dark:text-surface-400 mb-4 line-clamp-3">
        {project.description}
      </p>

      <div class="flex flex-wrap gap-1.5">
        {project.techStack.map((tech) => (
          <span class="inline-flex items-center rounded-none bg-paper-2 dark:bg-surface-800 px-2 py-0.5 text-xs text-surface-600 dark:text-surface-400">
            {tech}
          </span>
        ))}
      </div>
    </a>
  </div>
)}

<script>
  // @MX:NOTE: [AUTO] Pointer-reactive 3D tilt for project cards
  // Max 8° tilt, smooth easing, disabled on touch + reduced-motion.
  function initCardTilt() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isTouchPrimary       = window.matchMedia('(hover: none)').matches;

    if (prefersReducedMotion || isTouchPrimary) return;

    const wrappers = document.querySelectorAll<HTMLElement>('.card-tilt-wrapper');

    wrappers.forEach((wrapper) => {
      const inner = wrapper.querySelector<HTMLElement>('.card-tilt-inner');
      if (!inner) return;

      let ticking = false;

      function onPointerMove(e: PointerEvent) {
        if (ticking || !inner) return;
        ticking = true;
        requestAnimationFrame(() => {
          if (!inner) { ticking = false; return; }
          const rect   = wrapper.getBoundingClientRect();
          const cx     = rect.left + rect.width  / 2;
          const cy     = rect.top  + rect.height / 2;
          const dx     = (e.clientX - cx) / (rect.width  / 2); // -1 → 1
          const dy     = (e.clientY - cy) / (rect.height / 2); // -1 → 1

          // Max 8° tilt, letterpress-restrained
          const maxTilt = 8;
          const rotY    =  dx * maxTilt;
          const rotX    = -dy * maxTilt;
          const liftZ   = Math.abs(dx * dy) * 6 + 2; // subtle Z lift ≤ 8px

          inner.style.setProperty('--tilt-x', `${rotX}deg`);
          inner.style.setProperty('--tilt-y', `${rotY}deg`);
          inner.style.setProperty('--tilt-z', `${liftZ}px`);
          inner.setAttribute('data-tilting', '');
          ticking = false;
        });
      }

      function onPointerLeave() {
        if (!inner) return;
        inner.style.setProperty('--tilt-x', '0deg');
        inner.style.setProperty('--tilt-y', '0deg');
        inner.style.setProperty('--tilt-z', '0px');
        inner.removeAttribute('data-tilting');
      }

      wrapper.addEventListener('pointermove', onPointerMove, { passive: true });
      wrapper.addEventListener('pointerleave', onPointerLeave, { passive: true });
    });
  }

  initCardTilt();
  document.addEventListener('astro:after-swap', initCardTilt);
</script>
