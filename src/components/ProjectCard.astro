---
import type { Project } from '../types/project';
import { getTypeMeta, isRepositoryUrl, typeIcons } from '../utils/project-meta';

interface Props {
  project: Project;
  index?: number;
}

const { project, index = 0 } = Astro.props;

const typeMeta = getTypeMeta(project.type);
const isComingSoon = project.status === 'coming-soon';
const isArchived = project.status === 'archived';
const isRepo = isRepositoryUrl(project.url);
const iconSvg = typeIcons[typeMeta.icon] ?? typeIcons.generic;

// Search haystack — precomputed, lowercased, embedded as a data attribute
const haystack = [
  project.name,
  project.description,
  project.type,
  typeMeta.label,
  ...(project.techStack ?? []),
  ...(project.tags ?? []),
]
  .join(' ')
  .toLowerCase();

// Stagger: cap per-row offset so timing stays calm on dense grids.
// 50/40 keeps the last card of a 3x3 under 200ms; 80/60 pushed it to 280ms,
// and with a 0.4s entrance that is already 480ms after the card comes into view.
const staggerMs = Math.min(index % 3, 2) * 50 + Math.floor(index / 3) * 40;

// GitHub mark for repo links / arrow-up-right for live sites
const linkIcon = isRepo
  ? '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>'
  : '<path d="M7 17 17 7"/><path d="M7 7h10v10"/>';

const cardBase = [
  'group relative flex h-full flex-col rounded-xs border p-5 sm:p-6 card-surface',
  'border-paper-3 dark:border-surface-700 bg-paper dark:bg-surface-800',
  // Only border-color here. Active cards also carry .card-press, whose
  // unlayered `transition` shorthand outranks this utility entirely — two
  // competing shorthands on one element is how the hover lift broke before.
  'transition-[border-color] duration-200',
  'hover:border-ink/25 dark:hover:border-surface-600',
  isArchived && 'opacity-60',
];

const typeChip =
  'inline-flex items-center gap-1.5 rounded-xs border border-paper-3/70 dark:border-surface-700/70 bg-paper-2/60 dark:bg-surface-800/60 px-2 py-0.5 text-[11px] font-medium uppercase tracking-[0.08em] text-ink-2 dark:text-surface-300';

const typeIconSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-3 w-3 shrink-0" aria-hidden="true">${iconSvg}</svg>`;
---



{isComingSoon ? (
  <!-- Coming-soon: no tilt, no link, entrance only -->
  <div
    class:list={['card-entrance', cardBase, 'opacity-80 cursor-default']}
    style={`--motion-delay: ${staggerMs}ms`}
    data-type={String(project.type).toLowerCase()}
    data-search={haystack}
    aria-disabled="true"
  >
    <div class="mb-4 flex items-start justify-between gap-3">
      <span class:list={[typeChip]}>
        <Fragment set:html={typeIconSvg} />
        {typeMeta.label}
      </span>
      <span class="inline-flex items-center rounded-xs bg-paper-2 dark:bg-surface-800 px-2 py-0.5 text-[11px] font-medium uppercase tracking-[0.08em] text-ink-2 dark:text-surface-300">
        Coming Soon
      </span>
    </div>

    <h3 class="font-serif text-lg leading-snug text-ink dark:text-paper mb-2">{project.name}</h3>
    <p class="text-sm leading-relaxed text-ink-2 dark:text-surface-400 line-clamp-3">{project.description}</p>

    <div class="mt-auto pt-4 flex flex-wrap gap-1.5">
      {project.techStack.map((tech) => (
        <span class="font-mono text-xs px-1.5 py-0.5 rounded-xs bg-paper-2 dark:bg-surface-800/70 text-ink-2 dark:text-surface-300">
          {tech}
        </span>
      ))}
    </div>
  </div>
) : (
  <!-- Active card: entrance wrapper.
       `relative` is load-bearing: the source-code link below is absolutely
       positioned against this element, and it used to resolve here only
       because `perspective` on the old tilt wrapper made it a containing
       block. With the tilt gone, that positioning has to be explicit. -->
  <div
    class="card-entrance relative"
    style={`--motion-delay: ${staggerMs}ms`}
    data-type={String(project.type).toLowerCase()}
    data-search={haystack}
  >
    <a
      href={project.url}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[cardBase, 'card-press']}
    >
      <div class="mb-4 flex items-start justify-between gap-3">
        <span class:list={[typeChip]}>
        <Fragment set:html={typeIconSvg} />
        {typeMeta.label}
      </span>
        <span
          class="text-ink-quiet dark:text-surface-400 transition-all duration-200 group-hover:text-primary-600 dark:group-hover:text-primary-400"
          aria-hidden="true"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="card-arrow h-4 w-4"
            set:html={linkIcon}
          />
        </span>
      </div>

      <h3 class="font-serif text-lg leading-snug text-ink dark:text-paper mb-2 transition-colors group-hover:text-primary-600 dark:group-hover:text-primary-400">
        {project.name}
      </h3>
      <p class="text-sm leading-relaxed text-ink-2 dark:text-surface-400 line-clamp-3">{project.description}</p>

      <div class:list={['mt-auto pt-4 flex flex-wrap gap-1.5', project.repository && !isRepo && 'pr-12']}>
        {project.techStack.map((tech) => (
          <span class="font-mono text-xs px-1.5 py-0.5 rounded-xs bg-paper-2 dark:bg-surface-800/70 text-ink-2 dark:text-surface-300">
            {tech}
          </span>
        ))}
      </div>
    </a>
    {project.repository && !isRepo && (
      <!-- Secondary source link — sits outside the card anchor (valid HTML) -->
      <a
        href={project.repository}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Source code for ${project.name}`}
        class="absolute bottom-5 right-5 sm:bottom-6 sm:right-6 z-10 inline-flex h-8 w-8 items-center justify-center rounded-xs border border-paper-3/70 dark:border-surface-700 bg-paper dark:bg-surface-800 text-ink-2 dark:text-surface-300 transition-colors hover:text-ink dark:hover:text-paper hover:border-ink/30 dark:hover:border-surface-500"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-3.5 w-3.5"
          aria-hidden="true"
        >
          <path d="m16 18 6-6-6-6"/><path d="m8 6-6 6 6 6"/>
        </svg>
      </a>
    )}
  </div>
)}
