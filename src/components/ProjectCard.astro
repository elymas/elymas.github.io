---
import type { Project } from '../types/project';

interface Props {
  project: Project;
}

const { project } = Astro.props;

// Printing Press monochrome palette: paper/ink + crimson/pink/green accents
const typeColors: Record<string, { bg: string; text: string }> = {
  blog: { bg: 'bg-success-100 dark:bg-success-700/40', text: 'text-success-600 dark:text-success-400' },
  docs: { bg: 'bg-primary-100 dark:bg-primary-800/40', text: 'text-primary-700 dark:text-primary-300' },
  landing: { bg: 'bg-accent/15 dark:bg-accent/25', text: 'text-accent dark:text-accent' },
  app: { bg: 'bg-paper-2 dark:bg-surface-800', text: 'text-ink dark:text-paper' },
  tutorial: { bg: 'bg-success-100 dark:bg-success-700/40', text: 'text-success-700 dark:text-success-400' },
  portfolio: { bg: 'bg-accent/15 dark:bg-accent/25', text: 'text-accent dark:text-accent' },
};

const colors = typeColors[project.type] || typeColors.app;
const isComingSoon = project.status === 'coming-soon';
const isArchived = project.status === 'archived';
---

{isComingSoon ? (
  <div
    class:list={[
      'group block rounded-xs border border-paper-2 dark:border-surface-800 bg-paper dark:bg-surface-800 p-6 transition-all duration-200',
      'opacity-80 cursor-default',
      isArchived && 'opacity-60',
    ]}
  >
    <div class="flex items-start justify-between gap-3 mb-3">
      <span class:list={['inline-flex items-center rounded-none px-2.5 py-0.5 text-xs font-medium uppercase tracking-wider', colors.bg, colors.text]}>
        {project.type}
      </span>
      <span class="inline-flex items-center rounded-none bg-paper-2 dark:bg-surface-800 px-2.5 py-0.5 text-xs font-medium uppercase tracking-wider text-surface-600 dark:text-surface-400">
        Coming Soon
      </span>
    </div>

    <h3 class="font-serif text-lg font-semibold text-ink dark:text-paper mb-2 transition-colors">
      {project.name}
    </h3>

    <p class="text-sm text-surface-500 dark:text-surface-400 mb-4 line-clamp-3">
      {project.description}
    </p>

    <div class="flex flex-wrap gap-1.5">
      {project.techStack.map((tech) => (
        <span class="inline-flex items-center rounded-none bg-paper-2 dark:bg-surface-800 px-2 py-0.5 text-xs text-surface-600 dark:text-surface-400">
          {tech}
        </span>
      ))}
    </div>
  </div>
) : (
  <a
    href={project.url}
    target="_blank"
    rel="noopener noreferrer"
    class:list={[
      'group block rounded-xs border border-paper-2 dark:border-surface-800 bg-paper dark:bg-surface-800 p-6 transition-all duration-200',
      'hover:shadow-lg hover:border-primary-500 dark:hover:border-primary-400 hover:-translate-y-0.5',
      isArchived && 'opacity-60',
    ]}
  >
    <div class="flex items-start justify-between gap-3 mb-3">
      <span class:list={['inline-flex items-center rounded-none px-2.5 py-0.5 text-xs font-medium uppercase tracking-wider', colors.bg, colors.text]}>
        {project.type}
      </span>
    </div>

    <h3 class="font-serif text-lg font-semibold text-ink dark:text-paper mb-2 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
      {project.name}
    </h3>

    <p class="text-sm text-surface-500 dark:text-surface-400 mb-4 line-clamp-3">
      {project.description}
    </p>

    <div class="flex flex-wrap gap-1.5">
      {project.techStack.map((tech) => (
        <span class="inline-flex items-center rounded-none bg-paper-2 dark:bg-surface-800 px-2 py-0.5 text-xs text-surface-600 dark:text-surface-400">
          {tech}
        </span>
      ))}
    </div>
  </a>
)}
