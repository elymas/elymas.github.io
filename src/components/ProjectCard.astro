---
import type { Project } from '../types/project';
import { getTypeMeta, isRepositoryUrl, typeIcons } from '../utils/project-meta';

interface Props {
  project: Project;
  index?: number;
}

const { project, index = 0 } = Astro.props;

const typeMeta = getTypeMeta(project.type);
const isComingSoon = project.status === 'coming-soon';
const isArchived = project.status === 'archived';
const isRepo = isRepositoryUrl(project.url);
const iconSvg = typeIcons[typeMeta.icon] ?? typeIcons.generic;

// Search haystack — precomputed, lowercased, embedded as a data attribute
const haystack = [
  project.name,
  project.description,
  project.type,
  typeMeta.label,
  ...(project.techStack ?? []),
  ...(project.tags ?? []),
]
  .join(' ')
  .toLowerCase();

// Stagger: cap per-row offset so timing stays calm on dense grids
const staggerMs = Math.min(index % 3, 2) * 80 + Math.floor(index / 3) * 60;

// GitHub mark for repo links / arrow-up-right for live sites
const linkIcon = isRepo
  ? '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>'
  : '<path d="M7 17 17 7"/><path d="M7 7h10v10"/>';

const cardBase = [
  'group relative flex h-full flex-col rounded-xs border p-5 sm:p-6',
  'border-paper-2 dark:border-surface-800 bg-paper dark:bg-surface-800',
  'transition-[border-color,transform,box-shadow] duration-200',
  project.featured
    ? 'border-primary-500/40 dark:border-primary-400/30 hover:border-primary-500/70 dark:hover:border-primary-400/60'
    : 'hover:border-ink/25 dark:hover:border-surface-600',
  isArchived && 'opacity-60',
];

const typeChip =
  'inline-flex items-center gap-1.5 rounded-xs border border-paper-3/70 dark:border-surface-700/70 bg-paper-2/60 dark:bg-surface-800/60 px-2 py-0.5 text-[11px] font-medium uppercase tracking-[0.08em] text-ink-2 dark:text-surface-300';

const typeIconSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-3 w-3 shrink-0" aria-hidden="true">${iconSvg}</svg>`;
---



{isComingSoon ? (
  <!-- Coming-soon: no tilt, no link, entrance only -->
  <div
    class:list={['card-entrance motion-fade-up', cardBase, 'opacity-80 cursor-default']}
    style={`--motion-delay: ${staggerMs}ms`}
    data-type={String(project.type).toLowerCase()}
    data-search={haystack}
    aria-disabled="true"
  >
    <div class="mb-4 flex items-start justify-between gap-3">
      <span class:list={[typeChip]}>
        <Fragment set:html={typeIconSvg} />
        {typeMeta.label}
      </span>
      <span class="inline-flex items-center rounded-xs bg-paper-2 dark:bg-surface-800 px-2 py-0.5 text-[11px] font-medium uppercase tracking-[0.08em] text-ink-2 dark:text-surface-300">
        Coming Soon
      </span>
    </div>

    <h3 class="font-serif text-lg text-ink dark:text-paper mb-2">{project.name}</h3>
    <p class="text-sm leading-relaxed text-ink-2 dark:text-surface-400 line-clamp-3">{project.description}</p>

    <div class="mt-auto pt-4 flex flex-wrap gap-1.5">
      {project.techStack.map((tech) => (
        <span class="font-mono text-xs px-1.5 py-0.5 rounded-xs bg-paper-2 dark:bg-surface-800/70 text-ink-2 dark:text-surface-300">
          {tech}
        </span>
      ))}
    </div>
  </div>
) : (
  <!-- Active card: 3D tilt wrapper + entrance -->
  <div
    class="card-entrance motion-fade-up card-tilt-wrapper"
    style={`--motion-delay: ${staggerMs}ms`}
    data-type={String(project.type).toLowerCase()}
    data-search={haystack}
  >
    <a
      href={project.url}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[cardBase, 'card-tilt-inner ink-press', 'hover:-translate-y-0.5']}
    >
      <div class="mb-4 flex items-start justify-between gap-3">
        <span class:list={[typeChip]}>
        <Fragment set:html={typeIconSvg} />
        {typeMeta.label}
      </span>
        <span
          class="text-surface-500 dark:text-surface-400 transition-all duration-200 group-hover:text-primary-600 dark:group-hover:text-primary-400"
          aria-hidden="true"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            set:html={linkIcon}
          />
        </span>
      </div>

      <h3 class="font-serif text-lg text-ink dark:text-paper mb-2 transition-colors group-hover:text-primary-600 dark:group-hover:text-primary-400">
        {project.name}
      </h3>
      <p class="text-sm leading-relaxed text-ink-2 dark:text-surface-400 line-clamp-3">{project.description}</p>

      <div class:list={['mt-auto pt-4 flex flex-wrap gap-1.5', project.repository && !isRepo && 'pr-12']}>
        {project.techStack.map((tech) => (
          <span class="font-mono text-xs px-1.5 py-0.5 rounded-xs bg-paper-2 dark:bg-surface-800/70 text-ink-2 dark:text-surface-300">
            {tech}
          </span>
        ))}
      </div>
    </a>
    {project.repository && !isRepo && (
      <!-- Secondary source link — sits outside the card anchor (valid HTML) -->
      <a
        href={project.repository}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Source code for ${project.name}`}
        class="absolute bottom-5 right-5 sm:bottom-6 sm:right-6 z-10 inline-flex h-8 w-8 items-center justify-center rounded-xs border border-paper-3/70 dark:border-surface-700 bg-paper dark:bg-surface-800 text-ink-2 dark:text-surface-300 transition-colors hover:text-ink dark:hover:text-paper hover:border-ink/30 dark:hover:border-surface-500"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-3.5 w-3.5"
          aria-hidden="true"
        >
          <path d="m16 18 6-6-6-6"/><path d="m8 6-6 6 6 6"/>
        </svg>
      </a>
    )}
  </div>
)}

<script>
  // @MX:NOTE: [AUTO] Pointer-reactive 3D tilt for project cards
  // Max 8° tilt, smooth easing, disabled on touch + reduced-motion.
  function initCardTilt() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isTouchPrimary = window.matchMedia('(hover: none)').matches;

    if (prefersReducedMotion || isTouchPrimary) return;

    const wrappers = document.querySelectorAll<HTMLElement>('.card-tilt-wrapper');

    wrappers.forEach((wrapper) => {
      const inner = wrapper.querySelector<HTMLElement>('.card-tilt-inner');
      if (!inner) return;

      let ticking = false;

      function onPointerMove(e: PointerEvent) {
        if (ticking || !inner) return;
        ticking = true;
        requestAnimationFrame(() => {
          if (!inner) { ticking = false; return; }
          const rect = wrapper.getBoundingClientRect();
          const dx = (e.clientX - (rect.left + rect.width / 2)) / (rect.width / 2);
          const dy = (e.clientY - (rect.top + rect.height / 2)) / (rect.height / 2);

          const maxTilt = 8;
          inner.style.setProperty('--tilt-x', `${-dy * maxTilt}deg`);
          inner.style.setProperty('--tilt-y', `${dx * maxTilt}deg`);
          inner.style.setProperty('--tilt-z', `${Math.abs(dx * dy) * 6 + 2}px`);
          inner.setAttribute('data-tilting', '');
          ticking = false;
        });
      }

      function onPointerLeave() {
        if (!inner) return;
        inner.style.setProperty('--tilt-x', '0deg');
        inner.style.setProperty('--tilt-y', '0deg');
        inner.style.setProperty('--tilt-z', '0px');
        inner.removeAttribute('data-tilting');
      }

      wrapper.addEventListener('pointermove', onPointerMove, { passive: true });
      wrapper.addEventListener('pointerleave', onPointerLeave, { passive: true });
    });
  }

  initCardTilt();
  document.addEventListener('astro:after-swap', initCardTilt);
</script>
