---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'float on — a personal hub of projects, experiments, and writing hosted on GitHub Pages.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="float on" />
    <meta property="og:image" content={new URL('/banner.png', Astro.site)} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/banner.png', Astro.site)} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts: Newsreader (display) + Noto Serif KR (Hangul display) + Geist (body)
         + Geist Mono — Printing Press design language.
         Axes are requested at the weights the page actually sets, not the full
         range: Newsreader carries no italic here, and the two Geist faces are
         used at 400/500. Measured saving is small (141 → 138 @font-face,
         ~1.3KB of CSS) because Noto Serif KR's ~120 unicode-range subsets
         dominate the file — those are gated by range, so the browser still
         fetches only the Hangul it needs. The stylesheet stays render-blocking:
         `display=swap` already prevents invisible text, and deferring it would
         swap the font under the H1 after it has painted. Removing the round
         trip means self-hosting, which is a larger change than this.
         Newsreader carries no Hangul, and a trailing generic `serif` does not win
         the per-glyph fallback once installed Latin families precede it (measured:
         Hangul rendered at the system sans width), so Hangul in a serif heading
         dropped to sans mid-line. Noto Serif KR is named explicitly instead. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400..600&family=Noto+Serif+KR:wght@400..500&family=Geist:wght@300..600&family=Geist+Mono:wght@400..500&display=swap"
    />

    <!-- Theme color for browser chrome -->
    <meta name="theme-color" content="#f4efe6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1b1816" media="(prefers-color-scheme: dark)" />

    <!-- FOUC Prevention: apply theme before paint -->
    <!-- Motion gate: add js-motion before paint so CSS hidden states only apply when JS runs -->
    <script is:inline>
      (function () {
        const theme =
          localStorage.getItem('theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.classList.toggle('dark', theme === 'dark');
        document.documentElement.classList.add('js-motion');
      })();
    </script>
    <ClientRouter />
  </head>
  <!-- No colour transition here. It eased the body background over 200ms while
       every card, border and glyph switched instantly, so a theme flip read as
       a two-stage flash. Switching everything at once is the honest version. -->
  <body class="min-h-screen flex flex-col bg-surface-50 text-ink dark:bg-ink dark:text-paper">
    <!-- Paper grain — tactile texture layer, sits above everything but never intercepts input -->
    <div class="grain-overlay" aria-hidden="true"></div>
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
